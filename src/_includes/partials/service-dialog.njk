<dialog id="service-dialog" aria-labelledby="service-title"><div class="service-toolbar"><span class="eyebrow" id="service-category"></span><button id="service-close" type="button" aria-label="Close service details">×</button></div><div class="service-detail-layout"><div id="service-art-slot" aria-hidden="true"></div><div class="service-detail-copy"><h2 id="service-title"></h2><p id="service-intro"></p><ul id="service-offers"></ul><a class="primary" id="service-contact" href="/contact">Let’s talk <span aria-hidden="true">↗</span></a></div></div><div class="service-pagination" aria-label="Explore another service">{% for service in services %}<button data-service="{{ service.id }}" type="button">{{ service.name | e }}</button>{% endfor %}</div></dialog>
<script type="application/json" id="service-data">{{ services | serviceData | safe }}</script>
