<header class="site-header"><div class="header-inner wrap"><a class="wordmark" href="index.html" aria-label="{{ business.name }} home"{% if pageId == "home" %} aria-current="page"{% endif %}>{% include "partials/logo.njk" %}</a><nav aria-label="Main navigation">{% for item in site.mainNav %}<a href="{{ item.url }}"{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav><button class="header-cta contact-trigger">Let’s talk <span aria-hidden="true">↗</span></button><button class="menu-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button></div><nav id="mobile-menu" aria-label="Mobile navigation" hidden>{% for item in site.mainNav %}<a href="{{ item.url }}"{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }} <span>↗</span></a>{% endfor %}</nav></header>
