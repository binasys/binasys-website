<header class="site-header"><div class="header-inner wrap"><a class="wordmark" href="/" aria-label="{{ business.name }} home"{% if pageId == "home" %} aria-current="page"{% endif %}>{% include "partials/logo.njk" %}</a><nav aria-label="Main navigation">{% for item in site.mainNav %}<a href="{{ item.url }}"{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav><a class="header-cta" href="/contact"{% if pageId == "contact" %} aria-current="page"{% endif %}>Let’s talk <span aria-hidden="true">↗</span></a><button class="menu-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button></div><nav id="mobile-menu" aria-label="Mobile navigation" hidden>{% for item in site.mainNav %}<a href="{{ item.url }}"{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }} <span>↗</span></a>{% endfor %}</nav></header>
