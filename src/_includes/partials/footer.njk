<footer class="wrap"><a class="wordmark" href="/" aria-label="{{ business.name }} home">{% include "partials/logo.njk" %}</a><p>{{ business.tagline }}</p><nav class="footer-nav" aria-label="Footer navigation">{% for item in site.footerNav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</nav><div class="footer-legal"><p class="footer-company">© {{ year }} {{ business.legalName or business.name }}{% if business.registrationNumber %} ({{ business.registrationNumber }}){% endif %}. {{ business.office }}.</p>{% if business.contact.email or business.contact.phone or business.contact.whatsapp or business.linkedin %}<p class="footer-contact">{% if business.contact.whatsapp %}<a href="https://wa.me/{{ business.contact.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}{% if business.contact.email %}<a href="mailto:{{ business.contact.email }}">Email</a>{% endif %}{% if business.contact.phone %}<a href="tel:{{ business.contact.phone | replace(' ', '') | replace('-', '') }}">Call</a>{% endif %}{% if business.linkedin %}<a href="{{ business.linkedin }}" rel="noopener">LinkedIn</a>{% endif %}</p>{% endif %}<nav class="footer-legal-nav" aria-label="Legal">{% for item in site.legalNav %}<a href="{{ item.url }}"{% if item.lang %} lang="{{ item.lang }}" hreflang="{{ item.lang }}"{% endif %}{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav></div></footer>
