<dialog id="contact-dialog" aria-labelledby="contact-title"><div class="dialog-top"><p class="eyebrow">LET’S TALK</p><button type="button" id="contact-close" aria-label="Close contact panel">×</button></div><h2 id="contact-title">Tell us about<br> your business.</h2><p class="contact-message">We’ll start with a conversation about what you’d like to improve.</p>{% if business.contact.email or business.contact.phone %}<p class="contact-details">{% if business.contact.email %}<a href="mailto:{{ business.contact.email }}">{{ business.contact.email }}</a>{% endif %}{% if business.contact.phone %} <a href="tel:{{ business.contact.phone | replace(' ', '') }}">{{ business.contact.phone }}</a>{% endif %}</p>{% else %}<p class="contact-pending">{{ business.contact.pendingMessage }}</p>{% endif %}</dialog>
