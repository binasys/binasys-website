<!doctype html>
<html lang="{{ lang or site.lang }}"><head><meta charset="utf-8">{% if useBase %}<base href="{{ site.basePath }}">{% endif %}<meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><link rel="icon" href="assets/brand/favicons/favicon.ico" sizes="any"><link rel="icon" type="image/png" sizes="32x32" href="assets/brand/favicons/favicon-circle-32.png"><link rel="apple-touch-icon" href="assets/brand/favicons/apple-touch-icon.png"><link rel="manifest" href="assets/brand/favicons/site.webmanifest"><meta name="theme-color" content="#0066CC"><meta name="description" content="{{ description }}"><title>{{ title }}</title><meta property="og:type" content="website"><meta property="og:site_name" content="{{ business.name }}"><meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:locale" content="{{ "ms_MY" if lang == "ms" else "en_MY" }}"><meta name="twitter:card" content="summary">{% if noindex %}<meta name="robots" content="noindex">{% endif %}{% if redirectTo %}<meta http-equiv="refresh" content="0; url={{ redirectTo }}"><link rel="canonical" href="{{ redirectTo | replace('#ms', '') | replace('#en', '') }}">{% endif %}{% if bilingual %}<script>(function(){var d=document.documentElement,h=location.hash.slice(1),l=h==="ms"||h==="en"?h:null;if(!l){try{l=localStorage.getItem("bns-lang")}catch(e){}}if(l!=="ms")l="en";d.lang=l;d.setAttribute("data-legal-lang",l);if(l==="ms"&&{{ titleMs | dump | safe }})document.title={{ titleMs | dump | safe }};})();</script>{% endif %}<link rel="stylesheet" href="assets/brand/tokens.css"><link rel="stylesheet" href="assets/css/site.css">{% if serviceDialog %}<noscript><style>.service-trigger{display:none!important}</style></noscript>{% endif %}<script src="assets/js/navigation.js"></script></head>

<body data-page="{{ pageId }}"{% if bilingual %} data-title-en="{{ title }}" data-title-ms="{{ titleMs }}"{% endif %}>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% if serviceDialog %}
{% include "partials/service-dialog.njk" %}
{% endif %}
<script src="assets/js/app.js"></script></body></html>
