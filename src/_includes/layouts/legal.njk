---
layout: layouts/base.njk
---
{% if bilingual %}<section class="page-intro wrap" aria-labelledby="legal-title"><a class="back-home" href="index.html"><span aria-hidden="true">←</span> <span data-show-lang="en" lang="en">Home</span><span data-show-lang="ms" lang="ms">Laman utama</span></a><p class="eyebrow"><span data-show-lang="en" lang="en">{{ eyebrow }}</span><span data-show-lang="ms" lang="ms">{{ eyebrowMs }}</span></p><h1 id="legal-title"><span data-show-lang="en" lang="en">{{ heading }}</span><span data-show-lang="ms" lang="ms">{{ headingMs }}</span></h1><p><span data-show-lang="en" lang="en">Last updated: {{ updated }}</span><span data-show-lang="ms" lang="ms">Kemas kini terakhir: {{ updatedMs }}</span></p><div class="lang-toggle" role="group" aria-label="Language / Bahasa"><button type="button" data-set-lang="en" lang="en" aria-pressed="true" aria-label="English">EN</button><button type="button" data-set-lang="ms" lang="ms" aria-pressed="false" aria-label="Bahasa Malaysia">BM</button></div></section>{% else %}<section class="page-intro wrap" aria-labelledby="legal-title"><a class="back-home" href="index.html"><span aria-hidden="true">←</span> {{ "Laman utama" if lang == "ms" else "Home" }}</a><p class="eyebrow">{{ eyebrow }}</p><h1 id="legal-title">{{ heading }}</h1><p>{{ "Kemas kini terakhir" if lang == "ms" else "Last updated" }}: {{ updated }}</p></section>{% endif %}
<article class="legal-body wrap">
{{ content | safe }}
</article>
